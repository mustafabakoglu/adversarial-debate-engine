{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "debate-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8123",
        "--app-dir",
        "backend"
      ],
      "port": 8123
    },
    {
      "name": "debate-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "static-demo",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "frontend/dist"
      ],
      "port": 4173
    }
  ]
}
