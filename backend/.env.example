# Which provider adapter to use: mistral | anthropic
MODEL_PROVIDER=mistral

# API key for that provider. MISTRAL_API_KEY / ANTHROPIC_API_KEY are also accepted.
MODEL_API_KEY=

# Optional: several keys, comma-separated. A free tier is a quota and a quota runs
# out, so the provider rotates to the next key when one starts refusing instead of
# waiting out a limit it cannot get back. Useful for a hosted demo.
MODEL_API_KEYS=

# Leave blank to use the provider default
# (mistral -> mistral-large-latest, anthropic -> claude-opus-5).
MODEL_NAME=

# Reasoning effort. Honoured by the Anthropic adapter, ignored by Mistral.
# low | medium | high | xhigh | max
DEBATER_EFFORT=medium
JUDGE_EFFORT=high

# Only needed if the frontend is served from another origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum seconds between provider requests. Leave blank for the provider default
# (mistral 6s, anthropic 0). Raise it if you still hit rate limits.
REQUEST_MIN_INTERVAL=
